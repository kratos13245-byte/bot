# Copy to .env and replace the endpoints with your own servers.
AI_API_URL=http://127.0.0.1:8080/v1/chat/completions
REMOTE_TTS_URL=http://127.0.0.1:8092/tts
VISION_AUTO_START=0
VISION_API_URL=
IARA_API_KEY=
ENABLE_AVATAR=1
IARA_PANEL_PORT=8765
VTS_HOST=127.0.0.1
VTS_PORT=8001
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
TTS_EDGE_VOICE=pt-BR-ThalitaNeural
TTS_EDGE_RATE=+5%
TTS_EDGE_PITCH=+12Hz
ENABLE_TWITCH=0
ENABLE_YOUTUBE=0
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_VIDEO_ID=
YOUTUBE_LIVE_CHAT_ID=
YOUTUBE_POLL_INTERVAL_SEC=5

# Conversa e tempo de resposta (valores anteriores podem ser restaurados aqui).
AI_ALLOW_PROFANITY=1
AI_PROFANITY_LEVEL=alto
MIC_LIVE_COOLDOWN_SEC=0
MIC_END_SILENCE_MS=450
MIC_RANDOM_INTERRUPTION=0
TTS_PHRASE_PIPELINE=1

OBSIDIAN_AUTO_MEMORY=1
OBSIDIAN_VAULT_DIR=.
OBSIDIAN_MEMORY_BASE=IARA
# Optional: override the default <vault>/<base>/Procedures directory.
MC_PROCEDURES_DIR=

ENABLE_MINECRAFT=0
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=IARA_Bot
MC_BRIDGE_URL=http://127.0.0.1:8095
MC_RUNTIME_MODE=quality
MC_ACTION_TIMEOUT_SEC=120
MC_SELF_TRAIN_ENABLED=0
# Leave off when running main.py, to avoid executing commands twice.
MC_STANDALONE_COMMANDS=0

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_ID=
TWITCH_OWNER_ID=
TWITCH_CHANNEL=
TWITCH_ACCESS_TOKEN=
